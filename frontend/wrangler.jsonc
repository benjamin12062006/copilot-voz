{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "copilot-frontend",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "NUXT_PUBLIC_API_BASE_URL": "https://copilot-backend.benjamin12062006.workers.dev/api/v1",
    "NUXT_PUBLIC_DATA_SOURCE": "api",
    "NUXT_PUBLIC_CLERK_KEYLESS_DISABLED": "true",
    "NUXT_PUBLIC_PREVIEW_SESSION": "false",
  },
  "assets": { "directory": ".output/public", "binding": "ASSETS" },
  "observability": { "enabled": true },
}
