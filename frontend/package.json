{
  "name": "copilot-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local --host localhost --port 3000",
    "dev:preview": "NUXT_PUBLIC_PREVIEW_SESSION=true nuxt dev --dotenv .env.local --host localhost --port 3000",
    "build": "nuxt build --dotenv .env.local",
    "build:cloudflare": "node scripts/require-cloudflare-env.mjs && nuxt build --preset cloudflare_module",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .deploy-check",
    "deploy:cloudflare": "wrangler deploy",
    "preview": "nuxt preview --dotenv .env.local --host localhost --port 3000",
    "postinstall": "nuxt prepare --dotenv .env.local",
    "typecheck": "nuxt typecheck --dotenv .env.local",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clerk/nuxt": "^3.1.19",
    "@nuxt/ui": "4.12.0",
    "easy-speech": "2.4.0",
    "marked": "18.1.1",
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.144",
    "@nuxt/eslint": "1.17.0",
    "@types/node": "^24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.156.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  }
}
