{
  "name": "copilot-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host localhost --port 3000",
    "build": "nuxt build",
    "preview": "nuxt preview --host localhost --port 3000",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clerk/nuxt": "^3.1.19",
    "@fontsource/roboto": "5.3.0",
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  }
}
