# Copiar a .env.local (los scripts de package.json lo cargan con --dotenv).
# La clave publicable sí llega al navegador; la secreta solo al servidor Nuxt.
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=
# Impedir que el SDK cree una aplicación de desarrollo sin claves.
NUXT_PUBLIC_CLERK_KEYLESS_DISABLED=true

NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
# mock: perfil, documentos y voz simulados. api: llamar a la API real.
NUXT_PUBLIC_DATA_SOURCE=api
