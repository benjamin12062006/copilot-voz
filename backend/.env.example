# Variables previstas; Settings se implementará en API 01.
COPILOT_ENV=development
COPILOT_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Clerk, exclusivamente servidor. Completar en API 02.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000","http://127.0.0.1:3000"]
COPILOT_ALLOWED_CLERK_USER_IDS=[]
# Turso remoto para usuarios. Elegir driver según motor/URL.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Bucket privado para documentos, API 03.
UPSTASH_BLOB_TOKEN=
COPILOT_STORAGE_NAMESPACE=copilot/dev
COPILOT_STORAGE_MAX_DOCUMENT_BYTES=1048576
UPSTASH_DISABLE_TELEMETRY=1
# MCP propio, API 04: hash del token y propietario local fijo, sin token original.
COPILOT_MCP_TOKEN_SHA256=
COPILOT_MCP_OWNER_ID=
# Motor/modelos se definirán tras evaluar voz y compatibilidad Python.
