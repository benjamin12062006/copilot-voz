# Configuración de FastAPI. Copiar a .env; nunca versionar credenciales.
COPILOT_ENV=development
COPILOT_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Base nueva exclusiva de Copilot en Turso Cloud, motor libSQL.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Origen público de la instancia que firma el token; no es una secret key.
CLERK_ISSUER=
# Las variables de otros proveedores se añadirán cuando llegue su etapa.

# Biblioteca privada (el token ya configurado puede reutilizarse).
UPSTASH_BLOB_TOKEN=
# Los tokens MCP se emiten por usuario mediante POST /api/v1/mcp/tokens.
