# MCP implementado: completar credenciales antes de registrarlo.
# Fusionar con .codex/config.toml al cerrar API 04; no sustituir otras entradas.
[mcp_servers.copilot-voz]
command = "/Users/benji/.local/bin/uv"
args = ["--directory", "/Users/benji/Documents/Copilot/backend", "run", "--locked", "python", "-m", "app.mcp_server"]

[mcp_servers.copilot-voz.env]
COPILOT_MCP_ENV_FILE = "/Users/benji/Documents/Copilot/backend/mcp-clients/.env"
