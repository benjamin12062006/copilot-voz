{
  "name": "copilot-backend-cloudflare",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=22.21.0" },
  "scripts": {
    "dev:cloudflare": "wrangler dev",
    "typecheck:cloudflare": "tsc --noEmit",
    "check:cloudflare": "wrangler deploy --dry-run --containers-rollout=none --outdir .deploy-check",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": { "@cloudflare/containers": "0.3.7" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "typescript": "6.0.3",
    "wrangler": "4.156.0"
  }
}
